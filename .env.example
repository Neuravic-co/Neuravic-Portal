# Where the SQLite database file lives. Defaults to data/portal.db inside the project.
PORTAL_DB_PATH=

# Comma-separated email domains allowed to sign up, for example "neuravic.com". Required in production unless
# PORTAL_ALLOW_OPEN_SIGNUP is true.
PORTAL_ALLOWED_EMAIL_DOMAINS=

# Production only: set to true to let any email address sign up when no domains are listed above. The first account
# on a new portal becomes admin, so only do this once an admin exists or on a network you trust.
PORTAL_ALLOW_OPEN_SIGNUP=

# Set to true only when the portal sits behind a reverse proxy that overwrites X-Forwarded-For. Rate limits then use
# the client address the proxy reports; without it all callers share one bucket.
PORTAL_TRUST_PROXY=

# Public address of the portal, used to build the links in emails (never taken from request headers). Required in
# production for email to work, for example "https://portal.neuravic.com".
PORTAL_BASE_URL=

# Email (sign-up confirmation and password reset). Email is on when SMTP_HOST is set. For local development run Mailpit
# (docker compose -f docker-compose.dev.yml up -d) and use SMTP_HOST=127.0.0.1 SMTP_PORT=1025.
SMTP_HOST=
SMTP_PORT=587
# true for TLS from the first byte (usually port 465); otherwise the connection upgrades with STARTTLS.
SMTP_SECURE=
# true to refuse to send over an unencrypted connection. Keep this on with a real provider.
SMTP_REQUIRE_TLS=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Neuravic Portal <no-reply@your-domain.example>

# Production only: set to true to let people sign up from an allowed domain without confirming their email, which means
# anyone can claim any address on that domain. Leave this off and set up email instead.
PORTAL_ALLOW_UNVERIFIED_EMAIL=
