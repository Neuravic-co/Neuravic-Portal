# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# typescript
next-env.d.ts
/dist/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/
*.tsbuildinfo

# Local database
/data/

# Written by `next dev`; not part of the project
/AGENTS.md

# Secrets and keys: never commit these
*.key
*.crt
*.p12
*.pfx
id_rsa*
.npmrc
secrets/

# Databases and backups (they hold password hashes and personal data)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sql
*.bak

# Logs, editors and OS files
*.log
logs/
.vscode/*
!.vscode/extensions.json
.idea/
Thumbs.db
desktop.ini
.vercel/
